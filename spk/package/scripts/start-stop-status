#!/bin/sh
set -u

[ $# -eq 1 ] || exit 64
[ -n "${SYNOPKG_PKGDEST:-}" ] || exit 1
nutus3000_control_library=$SYNOPKG_PKGDEST/share/nut-us3000/lib.sh
nutus3000_hostctl=$SYNOPKG_PKGDEST/libexec/nut/nut-us3000-hostctl
[ -f "$nutus3000_control_library" ] && [ ! -L "$nutus3000_control_library" ] || exit 1
[ -f "$nutus3000_hostctl" ] && [ ! -L "$nutus3000_hostctl" ] && [ -x "$nutus3000_hostctl" ] || exit 1
. "$nutus3000_control_library" || exit 1

case $1 in
    start|stop)
        nutus3000_description_state=error
        trap 'nutus3000_description_finish "$?" "$nutus3000_description_state"' EXIT
        ;;
esac

case $1 in
    start)
        nutus3000_description_publish pending
        nutus3000_init || exit 1
        nutus3000_validate_platform || exit 1
        nutus3000_validate_config || exit 1
        nutus3000_prepare_run || exit 1
        nutus3000_ram_result=$("$nutus3000_hostctl" ram-start)
        nutus3000_start_rc=$?
        if [ "$nutus3000_start_rc" -eq 0 ] && [ "$nutus3000_ram_result" = RAM_STATE=HEALTHY ]; then
            nutus3000_first_delay=300
            nutus3000_description_state=healthy
            nutus3000_health_state=HEALTHY
        elif [ "$nutus3000_start_rc" -eq 0 ] && [ "$nutus3000_ram_result" = RAM_STATE=DEGRADED ]; then
            nutus3000_first_delay=300
            nutus3000_description_state=degraded
            nutus3000_health_state=DEGRADED_1
        elif [ "$nutus3000_start_rc" -eq 75 ] && [ "$nutus3000_ram_result" = RAM_STATE=UNAVAILABLE ]; then
            nutus3000_first_delay=$(nutus3000_first_delay_after_unavailable) || exit 1
            nutus3000_description_state=unavailable
            nutus3000_health_state=UNAVAILABLE
            if [ "$nutus3000_first_delay" -gt 0 ]; then
                nutus3000_description_state=waiting
            fi
        else
            exit 1
        fi
        nutus3000_publish_controller_state "$nutus3000_health_state" || exit 1
        if nutus3000_controller_status; then exit 0; fi
        if nutus3000_controller_start "$nutus3000_first_delay"; then
            exit 0
        fi
        "$nutus3000_hostctl" ram-stop >/dev/null 2>&1 || :
        exit 1
        ;;
    stop)
        # Only a system-originated stop with no explicit package operation may
        # consult the fresh safe-shutdown queue. Unknown nonempty statuses stop.
        if [ -n "${SYNOPKG_PKG_STATUS:-}" ]; then
            "$nutus3000_hostctl" ram-stop || exit 1
        else
            "$nutus3000_hostctl" ram-hook-stop || exit 1
        fi
        nutus3000_description_state=stopped
        ;;
    status)
        "$nutus3000_hostctl" audit || exit 1
        nutus3000_status
        ;;
    *) exit 64 ;;
esac
exit $?
