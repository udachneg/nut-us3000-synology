#!/bin/sh
set -eu

umask 077

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

reject_symlink_components() {
    checked_path=$1
    case "$checked_path" in
        /*) ;;
        *) return 1 ;;
    esac
    while [ "$checked_path" != / ]; do
        [ ! -L "$checked_path" ] || return 1
        checked_path=${checked_path%/*}
        [ -n "$checked_path" ] || checked_path=/
    done
}

canonical_dir() {
    canonical_input=$1
    [ -d "$canonical_input" ] || return 1
    (
        CDPATH= cd -P "$canonical_input" 2>/dev/null || exit 1
        pwd -P
    )
}

mode_is_0750() {
    mode_line=$(LC_ALL=C ls -ld "$1") || return 1
    case "$mode_line" in
        drwxr-x---*) return 0 ;;
        *) return 1 ;;
    esac
}

mode_is_0640() {
    mode_line=$(LC_ALL=C ls -ld "$1") || return 1
    case "$mode_line" in
        -rw-r-----*) return 0 ;;
        *) return 1 ;;
    esac
}

mode_is_0600() {
    mode_line=$(LC_ALL=C ls -ld "$1") || return 1
    case "$mode_line" in
        -rw-------*) return 0 ;;
        *) return 1 ;;
    esac
}

owner_is_effective() {
    owner_line=$(LC_ALL=C ls -ldn "$1") || return 1
    set -- $owner_line
    [ "$#" -ge 4 ] || return 1
    [ "$3" = "$effective_uid" ] && [ "$4" = "$effective_gid" ]
}

hash_file() {
    hash_path=$1
    if command -v sha256sum >/dev/null 2>&1; then
        hash_line=$(sha256sum "$hash_path") || return 1
    elif command -v shasum >/dev/null 2>&1; then
        hash_line=$(shasum -a 256 "$hash_path") || return 1
    else
        return 1
    fi
    hash_value=${hash_line%% *}
    [ "$hash_line" = "$hash_value  $hash_path" ] || return 1
    case "$hash_value" in
        *[!0-9a-f]*|'') return 1 ;;
    esac
    [ "${#hash_value}" -eq 64 ] || return 1
    printf '%s\n' "$hash_value"
}

[ -n "${SYNOPKG_PKGDEST:-}" ] || fail "package destination is unavailable"
[ -n "${SYNOPKG_PKGVAR:-}" ] || fail "package variable directory is unavailable"
effective_uid=$(/usr/bin/id -u) || fail "package user is unavailable"
effective_gid=$(/usr/bin/id -g) || fail "package group is unavailable"
case "$effective_uid:$effective_gid" in
    *[!0-9:]*) fail "package identity is malformed" ;;
esac

hostctl=$SYNOPKG_PKGDEST/libexec/nut/nut-us3000-hostctl
[ -f "$hostctl" ] && [ ! -L "$hostctl" ] && [ -x "$hostctl" ] \
    || fail "native host integration helper is unavailable"
"$hostctl" retire-port-config \
    || fail "legacy DSM port configuration retirement failed"

config_alias=/var/packages/nut-us3000/etc
config_parent=${config_alias%/*}
template_dir=$SYNOPKG_PKGDEST/share/nut-us3000/templates
package_var=$(canonical_dir "$SYNOPKG_PKGVAR") \
    || fail "unsafe package variable path"
manifest=$package_var/config-manifest.sha256

reject_symlink_components "$config_parent" || fail "unsafe configuration path"
reject_symlink_components "$package_var" || fail "unsafe package variable path"
[ -d "$config_parent" ] || fail "configuration parent is unavailable"
[ -d "$package_var" ] || fail "package variable directory is unavailable"

if [ -L "$config_alias" ]; then
    config_dir=$(canonical_dir "$config_alias") || fail "unsafe configuration path"
    case "$package_var" in
        */@appdata/nut-us3000)
            expected_config_dir=${package_var%/@appdata/nut-us3000}/@appconf/nut-us3000
            ;;
        *) fail "unsafe configuration path" ;;
    esac
    [ "$config_dir" = "$expected_config_dir" ] || fail "unsafe configuration path"
    reject_symlink_components "$config_dir" || fail "unsafe configuration path"
    stage_parent=$config_dir
else
    config_dir=$config_alias
    reject_symlink_components "$config_dir" || fail "unsafe configuration path"
    stage_parent=$config_parent
fi

for source in "$template_dir/ups.conf" "$template_dir/upsd.conf"; do
    [ ! -L "$source" ] || fail "unsafe configuration template"
    [ -f "$source" ] || fail "configuration template is unavailable"
done

existing_count=0
for target in "$config_dir/ups.conf" "$config_dir/upsd.conf" "$config_dir/upsd.users" "$manifest"; do
    if [ -e "$target" ] || [ -L "$target" ]; then
        existing_count=$((existing_count + 1))
    fi
done
case $existing_count in
    0) existing_publication=0 ;;
    4) existing_publication=1 ;;
    *) fail "configuration publication is incomplete" ;;
esac

config_created=0
if [ -e "$config_dir" ]; then
    [ -d "$config_dir" ] || fail "configuration path is not a directory"
    if [ "$existing_publication" -eq 1 ]; then
        mode_is_0750 "$config_dir" || fail "configuration directory mode is not 0750"
        owner_is_effective "$config_dir" || fail "configuration directory owner mismatch"
    else
        chmod 750 "$config_dir" || fail "configuration directory mode cannot be set"
        mode_is_0750 "$config_dir" || fail "configuration directory mode is not 0750"
    fi
fi

remove_if_our_inode() {
    staged_path=$1
    final_path=$2
    if [ -f "$staged_path" ] && [ ! -L "$final_path" ] && [ -f "$final_path" ] \
        && [ "$staged_path" -ef "$final_path" ]; then
        rm -f "$final_path"
    fi
}

strict_numeric_inode() {
    inode_path=$1
    inode_line=$(LC_ALL=C ls -id "$inode_path") || return 1
    inode_value=${inode_line%% *}
    case "$inode_value" in
        *[!0-9]*|'') return 1 ;;
    esac
    [ "$inode_line" = "$inode_value $inode_path" ] || return 1
    printf '%s\n' "$inode_value"
}

stage=
config_created_inode=
cleanup() {
    status=$?
    trap - 0
    if [ "$status" -ne 0 ]; then
        if [ -n "$stage" ]; then
            remove_if_our_inode "$stage/upsd.users" "$config_dir/upsd.users" || :
            remove_if_our_inode "$stage/upsd.conf" "$config_dir/upsd.conf" || :
            remove_if_our_inode "$stage/ups.conf" "$config_dir/ups.conf" || :
        fi
        if [ "$config_created" -ne 0 ] && [ ! -L "$config_dir" ] && [ -d "$config_dir" ] \
            && current_config_inode=$(strict_numeric_inode "$config_dir") \
            && [ -n "$config_created_inode" ] \
            && [ "$current_config_inode" = "$config_created_inode" ]; then
            rmdir "$config_dir" || :
        fi
    fi
    [ -z "$stage" ] || rm -rf "$stage" || :
    exit "$status"
}
trap cleanup 0

stage=$(mktemp -d "$stage_parent/.nut-us3000-postinst.XXXXXX") || exit 1

cp "$template_dir/ups.conf" "$stage/ups.conf"
cp "$template_dir/upsd.conf" "$stage/upsd.conf"
printf '%s\n' '[monuser]' '    password = secret' '    upsmon secondary' > "$stage/upsd.users"
chmod 640 "$stage/ups.conf" "$stage/upsd.conf"
chmod 600 "$stage/upsd.users"

manifest_source=$stage/config-manifest.sha256
: > "$manifest_source"
for name in ups.conf upsd.conf upsd.users; do
    digest=$(hash_file "$stage/$name") || fail "configuration hashing failed"
    printf '%s  %s\n' "$digest" "$name" >> "$manifest_source"
done
chmod 600 "$manifest_source"

if [ "$existing_publication" -eq 1 ]; then
    existing_manifest=$stage/existing-config-manifest.sha256
    (
        cd -P "$config_dir" || exit 1
        [ ! -L "$config_dir" ] && [ "." -ef "$config_dir" ] || exit 1
        for name in ups.conf upsd.conf; do
            [ -f "$name" ] && [ ! -L "$name" ] || exit 1
            mode_is_0640 "$name" || exit 1
            owner_is_effective "$name" || exit 1
        done
        [ -f upsd.users ] && [ ! -L upsd.users ] || exit 1
        mode_is_0600 upsd.users || exit 1
        owner_is_effective upsd.users || exit 1
        [ ! -L "$config_dir" ] && [ "." -ef "$config_dir" ] || exit 1
    ) || fail "existing configuration does not match"
    (
        cd -P "$package_var" || exit 1
        [ ! -L "$package_var" ] && [ "." -ef "$package_var" ] || exit 1
        [ -f config-manifest.sha256 ] && [ ! -L config-manifest.sha256 ] || exit 1
        mode_is_0600 config-manifest.sha256 || exit 1
        owner_is_effective config-manifest.sha256 || exit 1
        [ ! -L "$package_var" ] && [ "." -ef "$package_var" ] || exit 1
    ) || fail "existing configuration manifest does not match"

    : > "$existing_manifest"
    for name in ups.conf upsd.conf upsd.users; do
        digest=$(hash_file "$config_dir/$name") \
            || fail "existing configuration hashing failed"
        printf '%s  %s\n' "$digest" "$name" >> "$existing_manifest"
    done
    cmp -s "$manifest" "$existing_manifest" \
        || fail "existing configuration manifest does not match"

    if cmp -s "$config_dir/ups.conf" "$stage/ups.conf" \
        && cmp -s "$config_dir/upsd.conf" "$stage/upsd.conf" \
        && cmp -s "$config_dir/upsd.users" "$stage/upsd.users" \
        && cmp -s "$manifest" "$manifest_source"; then
        exit 0
    fi

    legacy_0007_upsd=$stage/upsd.conf.0007
    printf '%s\n' 'LISTEN 127.0.0.1 3493' > "$legacy_0007_upsd"
    chmod 640 "$legacy_0007_upsd"
    cmp -s "$config_dir/ups.conf" "$stage/ups.conf" \
        && cmp -s "$config_dir/upsd.conf" "$legacy_0007_upsd" \
        && cmp -s "$config_dir/upsd.users" "$stage/upsd.users" \
        || fail "existing configuration does not match"

    migrate_0007() (
        config_migration=
        manifest_migration=
        new_upsd_inode=
        new_manifest_inode=

        restore_old_file() {
            backup_path=$1
            final_path=$2
            published_inode=$3
            final_mode=$4

            [ -f "$backup_path" ] && [ ! -L "$backup_path" ] || return 1
            [ -f "$final_path" ] && [ ! -L "$final_path" ] || return 1
            if [ "$backup_path" -ef "$final_path" ]; then
                return 0
            fi
            current_inode=$(strict_numeric_inode "$final_path") || return 1
            [ "$current_inode" = "$published_inode" ] || return 1
            cp "$backup_path" "$final_path" || return 1
            chmod "$final_mode" "$final_path" || return 1
            owner_is_effective "$final_path" || return 1
            cmp -s "$backup_path" "$final_path"
        }

        migration_cleanup() {
            migration_status=$?
            trap - 0
            keep_recovery=0
            if [ "$migration_status" -ne 0 ]; then
                restore_old_file \
                    "$config_migration/upsd.conf.old" \
                    "$config_dir/upsd.conf" \
                    "$new_upsd_inode" 640 || keep_recovery=1
                restore_old_file \
                    "$manifest_migration/config-manifest.sha256.old" \
                    "$manifest" \
                    "$new_manifest_inode" 600 || keep_recovery=1
            fi
            if [ "$keep_recovery" -eq 0 ]; then
                [ -z "$config_migration" ] || rm -rf "$config_migration" || :
                [ -z "$manifest_migration" ] || rm -rf "$manifest_migration" || :
            fi
            exit "$migration_status"
        }
        trap migration_cleanup 0

        reject_symlink_components "$config_dir" || exit 1
        reject_symlink_components "$package_var" || exit 1
        [ "$(canonical_dir "$config_dir")" = "$config_dir" ] || exit 1
        [ "$(canonical_dir "$package_var")" = "$package_var" ] || exit 1

        config_migration=$(mktemp -d "$config_dir/.nut-us3000-postinst.XXXXXX") \
            || exit 1
        manifest_migration=$(mktemp -d "$package_var/.nut-us3000-postinst.XXXXXX") \
            || exit 1

        cp "$stage/upsd.conf" "$config_migration/upsd.conf.new"
        chmod 640 "$config_migration/upsd.conf.new"
        ln "$config_dir/upsd.conf" "$config_migration/upsd.conf.old"
        cp "$manifest_source" "$manifest_migration/config-manifest.sha256.new"
        chmod 600 "$manifest_migration/config-manifest.sha256.new"
        ln "$manifest" "$manifest_migration/config-manifest.sha256.old"

        new_upsd_inode=$(strict_numeric_inode "$config_migration/upsd.conf.new") \
            || exit 1
        new_manifest_inode=$(
            strict_numeric_inode "$manifest_migration/config-manifest.sha256.new"
        ) || exit 1

        mv "$config_migration/upsd.conf.new" "$config_dir/upsd.conf"
        mv "$manifest_migration/config-manifest.sha256.new" "$manifest"
    )

    migrate_0007
    exit 0
fi

if [ ! -e "$config_dir" ]; then
    mkdir "$config_dir"
    config_created=1
    config_created_inode=$(strict_numeric_inode "$config_dir") || exit 1
    chmod 750 "$config_dir"
fi

(
    cd -P "$config_dir" || exit 1

    config_anchor_cleanup() {
        anchor_status=$?
        trap - 0
        if [ "$anchor_status" -ne 0 ]; then
            remove_if_our_inode "$stage/upsd.users" "upsd.users" || :
            remove_if_our_inode "$stage/upsd.conf" "upsd.conf" || :
            remove_if_our_inode "$stage/ups.conf" "ups.conf" || :
        fi
        exit "$anchor_status"
    }
    trap config_anchor_cleanup 0

    [ ! -L "$config_dir" ] && [ "." -ef "$config_dir" ] || exit 1
    ln "$stage/ups.conf" "ups.conf"
    ln "$stage/upsd.conf" "upsd.conf"
    ln "$stage/upsd.users" "upsd.users"
    [ ! -L "$config_dir" ] && [ "." -ef "$config_dir" ] || exit 1

    (
        cd -P "$package_var" || exit 1

        manifest_stage=
        local_manifest=
        manifest_anchor_cleanup() {
            manifest_status=$?
            trap - 0
            if [ "$manifest_status" -ne 0 ] && [ -n "$local_manifest" ]; then
                remove_if_our_inode "$local_manifest" "config-manifest.sha256" || :
            fi
            [ -z "$manifest_stage" ] || rm -rf "$manifest_stage" || :
            exit "$manifest_status"
        }
        trap manifest_anchor_cleanup 0

        [ ! -L "$package_var" ] && [ "." -ef "$package_var" ] || exit 1
        manifest_stage=$(mktemp -d ".nut-us3000-postinst.XXXXXX") || exit 1
        local_manifest=$manifest_stage/config-manifest.sha256
        cp "$manifest_source" "$local_manifest"
        chmod 600 "$local_manifest"
        ln "$local_manifest" "config-manifest.sha256"
        [ ! -L "$package_var" ] && [ "." -ef "$package_var" ] || exit 1
    )
)
